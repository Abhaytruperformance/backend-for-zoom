# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zri:zri@localhost:5442/zri
REDIS_URL=redis://localhost:6379

# 32-byte key (base64) for AES-256-GCM token encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# JWT signing secret for app auth sessions
JWT_SECRET=

# Comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OpenAI (only AI runtime) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Zoom OAuth (per-tenant meeting connection) ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4000/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Google OAuth (per-user Gmail send) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/mailbox/google/callback

# --- Microsoft OAuth (per-user Graph send) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/mailbox/microsoft/callback

# Domain used to build the deterministic outgoing Message-ID header
OUTBOUND_MESSAGE_ID_DOMAIN=zri.local

# Set to true to skip tests/integration (external-provider contract tests)
SKIP_INTEGRATION=true
