{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "grep -q '\"workspaces\"' package.json 2>/dev/null || cd ..; sh scripts/vercel-install.sh",
  "buildCommand": "ORIG=\"$PWD\"; grep -q '\"workspaces\"' package.json 2>/dev/null || cd ..; ORIG=\"$ORIG\" sh scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zri-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
